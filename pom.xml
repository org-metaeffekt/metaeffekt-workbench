    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>properties-maven-plugin</artifactId>
                <version>1.3.0</version>
                <executions>
                    <execution>
                        <phase>initialize</phase>
                        <goals>
                            <goal>read-project-properties</goal>
                        </goals>
                        <configuration>
                            <files>
                                <file>${project.basedir}/../.local.properties</file>
                                <file>${project.basedir}/.local.properties</file>
                            </files>
                            <quiet>true</quiet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.metaeffekt.kontinuum.runtime</groupId>
                <artifactId>ae-kontinuum-runtime-execution</artifactId>
                <version>HEAD-SNAPSHOT</version>
                <configuration>
                    <tmdPassword>${tmd.password}</tmdPassword>
                    <tmdUserkeysFile>${project.basedir}/config/kosmos/kosmos.consumer.keys</tmdUserkeysFile>
                    <artifactResolverConfigFile>${project.basedir}/config/resolver/artifact-resolver-config.yaml</artifactResolverConfigFile>
                    <artifactResolverProxyFile>${project.basedir}/config/resolver/artifact-resolver-proxy.yaml</artifactResolverProxyFile>
                    <scanPropertiesFile>${project.basedir}/config/scanner/scan-control.properties</scanPropertiesFile>
                    <vulnerabilityMirrorDir>${vulnerability.mirror.dir}</vulnerabilityMirrorDir>
                    <vulnerabilityMirrorUrl>${vulnerability.mirror.url}</vulnerabilityMirrorUrl>
                    <workbenchDir>${project.basedir}</workbenchDir>
                    <kontinuumDir>${ae.kontinuum.dir}</kontinuumDir>
                    <executionEnvironment>UNIX</executionEnvironment>

                    <portfolioManagerClientKeystoreFile>config/portfolio/pm-client-TEST-keystore.p12</portfolioManagerClientKeystoreFile>
                    <portfolioManagerClientTruststoreFile>config/portfolio/pm-client-TEST-truststore.p12</portfolioManagerClientTruststoreFile>
                    <portfolioManagerClientKeystorePassword>${portfolio.manager.client.keystore.password}</portfolioManagerClientKeystorePassword>
                    <portfolioManagerClientTruststorePassword>${portfolio.manager.client.truststore.password}</portfolioManagerClientTruststorePassword>
                    <portfolioManagerToken>${portfolio.manager.token}</portfolioManagerToken>
                    <portfolioManagerUrl>https://192.168.178.100:8444</portfolioManagerUrl>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <executable>bash</executable>
                    <!-- Honor Maven's conventional -DskipTests option while still generating pipelines. -->
                    <skip>${skipTests}</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
