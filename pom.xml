    <groupId>org.metaeffekt.workbench</groupId>
    <artifactId>dynamic-pipeline-generator</artifactId>
    <version>WORKBENCH-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <skipTests>false</skipTests>
    </properties>

    <profiles>
        <!-- With no explicitly selected profile Maven activates all defaults; selecting one project profile
             deactivates the other defaults, so its pipeline alone is generated and run. -->
        <profile>
            <id>alpine</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.metaeffekt.kontinuum.runtime</groupId>
                        <artifactId>ae-kontinuum-runtime-execution</artifactId>
                        <executions>
                            <execution>
                                <id>generate-alpine-pipeline</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>generate-local-pipeline</goal>
                                </goals>
                                <configuration>
                                    <pipelineConfigPath>${project.basedir}/tests/project-definitions/alpine-container.yaml</pipelineConfigPath>
                                    <outputFile>${project.basedir}/tests/target/alpine-container/pipeline.sh</outputFile>
                                    <workspaceDir>${project.basedir}/tests/target/alpine-container/workspace/</workspaceDir>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>execute-alpine-pipeline</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <arguments>
                                        <argument>${project.basedir}/tests/target/alpine-container/pipeline.sh</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
